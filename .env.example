NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DELIVERY_PHOTOS_BUCKET=delivery-photos

# Evolution API
# Use a raiz da API do Evolution. O app monta /message/sendText/{instance} e /message/sendMedia/{instance} sozinho.
EVOLUTION_BASE_URL=https://your-evolution-host
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=your_instance_name
EVOLUTION_WEBHOOK_SECRET=optional_shared_secret

# Optional integrations
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=portaria@your-domain.com
